rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function clanMember(clanId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/clans/$(clanId)).data.memberUids;
    }

    match /catalogs/{catalogId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /players/{uid} {
      allow read: if signedIn();
      allow write: if false;

      match /battles/{battleId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /clans/{clanId} {
      allow read: if signedIn();
      allow write: if false;

      match /chat/{messageId} {
        allow read: if clanMember(clanId);
        allow create: if clanMember(clanId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 280;
        allow update, delete: if false;
      }
    }

    match /leaderboards/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /raids/{raidId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /world/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
