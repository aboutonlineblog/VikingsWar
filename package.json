{
  "name": "vikingswar",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "emulators": "bash scripts/run-emulators.sh",
    "seed": "bash scripts/run-seed.sh",
    "parse-creatures": "tsx scripts/parse-creatures.ts",
    "generate-portraits": "tsx scripts/generate-creature-portraits.ts",
    "functions:build": "npm --prefix functions run build",
    "build:apk": "cd android && rm -rf app/.cxx build/generated/autolinking && ./gradlew clean && ./gradlew assembleRelease && cd ..",
    "build:release": "cd android && rm -rf app/.cxx build/generated/autolinking && ./gradlew clean && ./gradlew bundleRelease && cd .."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/auth": "^23.8.8",
    "@react-native-firebase/firestore": "^23.8.8",
    "@react-native-firebase/functions": "^23.8.8",
    "@react-native-firebase/storage": "^23.8.8",
    "@react-native/new-app-screen": "0.87.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@tanstack/react-query": "^5.90.21",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.23.0",
    "react-native-sound": "^0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.11.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
